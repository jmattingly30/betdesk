/**
 * Apps Script version of the win-probability tool (phone access). Bundle.gs holds the shared calculation code
 * (the same src/*.js files the computer version runs, generated by build_apps_script.ps1); this file is only
 * the Google-specific part: fetching (UrlFetchApp), the log (a Google Sheet in your Drive), settings, and the
 * 5-minute timer that fills in final scores and closing lines.
 *
 * One-time setup (details in README): Deploy as a web app, "Execute as: Me", "Who has access: Only myself";
 * run setup() once; optionally add ODDS_API_KEY in Project Settings -> Script Properties.
 * Keys and credentials live only in Script Properties, never in the page.
 */

var R_ = function (name) { return __require(name); };
var UA_ = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36';
var HOUR_S_ = 3600;

function MissingData_(message, items) { this.message = message; this.items = items || []; this.missingData = true; }

// ---------- web app entry points ----------
function doGet(e) {
  if (e && e.parameter && e.parameter.export === 'csv') {
    return ContentService.createTextOutput('﻿' + R_('playlog').toCsv(LogStore_.list()))
      .setMimeType(ContentService.MimeType.CSV).downloadAsFile('playlog_' + today_() + '.csv');
  }
  return HtmlService.createHtmlOutputFromFile('Index').setTitle('MLB win probability')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

// The page calls google.script.run.api(name, payload). Same names and shapes as the computer version's server.js.
function api(name, payload) {
  if (!Object.prototype.hasOwnProperty.call(API_, name)) throw new Error('unknown call ' + name);
  var result = API_[name](payload || {});
  // plain JSON only (no NaN/Infinity, no Maps) so google.script.run can hand it to the page
  return JSON.parse(JSON.stringify(result, function (k, v) { return typeof v === 'number' && !isFinite(v) ? null : v; }));
}

var API_ = {
  info: function () {
    return { host: 'apps-script', oddsFeed: !!oddsKey_(), oddsCreditsLeft: prop_('ODDS_REMAINING'), settings: settings_(),
      csvUrl: ScriptApp.getService().getUrl() + '?export=csv', books: R_('playlog').BOOKS, logSheetUrl: logSpreadsheet_().getUrl() };
  },
  saveSettings: function (p) {
    var s = settings_();
    if ('useFangraphs' in p) s.useFangraphs = !!p.useFangraphs;
    PropertiesService.getScriptProperties().setProperty('SETTINGS', JSON.stringify(s));
    return s;
  },
  lookup: function (p) {
    var G = R_('game'), cfg = config_();
    var date = p.date || today_();
    if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) return { error: 'date must be YYYY-MM-DD' };
    var found = G.gamesForTeam(fetchSchedule_(date), p.team || '', cfg);
    if (found.error) return { date: date, error: found.error };
    return { date: date, team: found.team.name, games: found.games.map(function (g) { return Object.assign({}, g, { readiness: G.readiness(g) }); }) };
  },
  run: function (p) {
    var G = R_('game'), L = R_('playlog'), O = R_('odds');
    if (!/^\d{4}-\d{2}-\d{2}$/.test(p.date) || !(p.gamePk === Math.floor(p.gamePk))) return { error: 'gamePk and date are required' };
    var cfg = config_();
    cfg.useFangraphs = 'useFangraphs' in p ? !!p.useFangraphs : settings_().useFangraphs;
    // re-fetch so lineups are as fresh as possible at the moment of confirmation
    var game = G.parseGames(fetchSchedule_(p.date), cfg).filter(function (g) { return g.gamePk === p.gamePk; })[0];
    if (!game) return { ok: false, missing: ['That game is no longer on the schedule.'] };
    var ready = G.readiness(game);
    if (!ready.ready) return { ok: false, missing: ready.problems.filter(function (x) { return x.indexOf('Note:') !== 0; }) };
    var loaded;
    try { loaded = loadSources_(game, cfg); }
    catch (e) {
      if (e && e.missingData) return { ok: false, missing: [e.message].concat(e.items, cfg.useFangraphs ? ['Or switch off "Use FanGraphs data" to run without bullpen, wRC+ and FRV.'] : []) };
      throw e;
    }
    var out = G.runGame(game, loaded.sources, cfg);
    if (!out.ok) return { ok: false, missing: out.missing, warnings: loaded.warnings.concat(out.warnings) };
    // every run goes in the play log, played or not
    var books = booksFor_(out.result);
    var logRow = LogStore_.insert(L.newRow(out.result, O.summarizeBooks(books), cfg));
    var warnings = loaded.warnings.concat(out.warnings);
    if (!cfg.useFangraphs) warnings.push('No-FanGraphs mode: the efficiency model and v3 use league-average bullpens; sheet models use no bullpen term, wRC+ 100, FRV 0.');
    return { ok: true, result: out.result, logRow: logRow, books: books, warnings: warnings };
  },
  log: function () {
    var L = R_('playlog'), rows = LogStore_.list();
    return { rows: rows.slice().sort(function (a, b) { return String(b.runAt).localeCompare(String(a.runAt)); }), summary: L.summarize(rows) };
  },
  update: function (p) {
    var L = R_('playlog'), errors = null;
    var row = LogStore_.update(String(p.id), function (r) { var x = L.applyEntry(r, p.patch); if (x.errors) { errors = x.errors; return r; } return x.row; });
    if (!row) return { error: 'No log entry with that id' };
    return errors ? { errors: errors } : { row: row };
  },
  remove: function (p) { return { deleted: LogStore_.remove(String(p.id)) }; },
  refresh: function () { return refreshLog(); },
  slate: function (p) { var d = exportSlate(p.date); return { date: d.date, games: d.games.length, pending: d.pending }; },
  uploadFangraphs: function (p) {
    var D = R_('data');
    var specs = { bullpen: D.BULLPEN_SPEC, team_wrc: D.WRC_SPEC, team_frv: D.FRV_SPEC };
    if (!specs[p.kind] || !/^\d{4}$/.test(String(p.season))) return { error: 'kind must be bullpen, team_wrc or team_frv, with a 4-digit season' };
    var text = String(p.text || '');
    var parsed = D.parseTeamTable(text, specs[p.kind]);
    if (parsed.teams.size < 30) return { error: 'Only ' + parsed.teams.size + ' of 30 teams recognized in that file' + (parsed.unknownTeams.length ? ' (unrecognized: ' + parsed.unknownTeams.slice(0, 5).join(', ') + ')' : '') };
    FgStore_.put(p.kind, String(p.season), text);
    return { saved: p.kind + '_' + p.season, teams: parsed.teams.size };
  },
};

// ---------- settings / properties ----------
function prop_(k) { return PropertiesService.getScriptProperties().getProperty(k); }
function oddsKey_() { return prop_('ODDS_API_KEY'); }
function settings_() {
  var s = {}; try { s = JSON.parse(prop_('SETTINGS') || '{}'); } catch (e) { s = {}; }
  return { useFangraphs: 'useFangraphs' in s ? !!s.useFangraphs : R_('config').useFangraphs !== false };
}
function config_() { return Object.assign({}, R_('config')); }
function today_() { return Utilities.formatDate(new Date(), Session.getScriptTimeZone() || 'America/New_York', 'yyyy-MM-dd'); }

// ---------- fetching ----------
function fetchText_(url, cacheKey, ttlSec) {
  var cache = CacheService.getScriptCache();
  if (cacheKey && ttlSec) { var hit = cache.get(cacheKey); if (hit != null) return hit; }
  var res = UrlFetchApp.fetch(url, { muteHttpExceptions: true, followRedirects: true, headers: { 'User-Agent': UA_ } });
  var code = res.getResponseCode();
  if (code !== 200) throw new MissingData_(url.split('/')[2] + ' returned HTTP ' + code + ' for ' + url.split('?')[0]);
  var text = res.getContentText();
  if (cacheKey && ttlSec && text.length < 95000) { try { cache.put(cacheKey, text, Math.min(ttlSec, 6 * HOUR_S_)); } catch (e) { /* too big to cache; fine */ } }
  return text;
}

function fetchSchedule_(date) {
  return JSON.parse(fetchText_('https://statsapi.mlb.com/api/v1/schedule?sportId=1&date=' + date + '&hydrate=team,probablePitcher,lineups,venue,weather'));
}

var PITCHER_SEL_ = 'p_formatted_ip,pa,woba,xwoba,k_percent,bb_percent';
// K%, BB% and ISO added 2026-10-10 for model v3 (new cache key so old 3-column files aren't reused)
var BATTER_SEL_ = 'pa,ab,woba,xwoba,k_percent,bb_percent,isolated_power';

// Catcher framing and fielding leaderboards (2026-10-16, Model v3 + defense)
function framingUrl_(season) { return 'https://baseballsavant.mlb.com/catcher_framing?year=' + season + '&team=&min=1&type=catcher&sort=4,1&csv=true'; }
function pitchFileUrl_(season, pid) { return 'https://baseballsavant.mlb.com/statcast_search/csv?all=true&hfSea=' + season + '%7C&hfGT=R%7C&player_type=pitcher&pitchers_lookup%5B%5D=' + pid + '&type=details&min_pitches=0&min_results=0&min_pas=0'; }
function oaaUrl_(season) { return 'https://baseballsavant.mlb.com/leaderboard/outs_above_average?type=Fielder&startYear=' + season + '&endYear=' + season + '&split=no&team=&range=year&min=1&pos=&roles=&viz=hide&csv=true'; }

function savantUrl_(season, type, sel) {
  return 'https://baseballsavant.mlb.com/leaderboard/custom?year=' + season + '&type=' + type + '&filter=&min=1&selections=' + sel + '&chart=false&x=pa&y=pa&r=no&chartType=beeswarm&csv=true';
}

// Baseball-Reference team games/PA/runs, parsed and cached small (the page itself is too big to cache).
// Current season: 6 hours (CacheService). Past seasons: 30 days (Script Properties).
function bbrefTeams_(season, current) {
  var D = R_('data'), key = 'bbref2_' + season, raw = null;   // bbref2: entries now carry team wOBA (run efficiency)
  if (current) raw = CacheService.getScriptCache().get(key);
  else { var p = prop_(key); if (p) { var o = JSON.parse(p); if (Date.now() - o.at < 30 * 24 * HOUR_S_ * 1000) raw = JSON.stringify(o.entries); } }
  if (raw) return new Map(JSON.parse(raw));
  if (!current) Utilities.sleep(3500);   // Baseball-Reference rate-limits; space out uncached requests
  var map = D.parseBbrefTeams(fetchText_('https://www.baseball-reference.com/leagues/majors/' + season + '.shtml'));
  var entries = JSON.stringify(Array.from(map.entries()));
  if (current) CacheService.getScriptCache().put(key, entries, 6 * HOUR_S_);
  else PropertiesService.getScriptProperties().setProperty(key, JSON.stringify({ at: Date.now(), entries: JSON.parse(entries) }));
  return map;
}

// Same logic as loadSources() in src/io.js, with Apps Script fetching and storage.
function loadSources_(game, cfg) {
  var D = R_('data'), U = R_('util');
  if (cfg.rqpaBasis === 'season' || cfg.batterSource === 'fangraphs-csv') throw new MissingData_('The phone version supports batterSource "savant" and rqpaBasis "tonight" only.');
  var warnings = [], season = game.season;
  var currentTeams = bbrefTeams_(season, true);
  var gp = [game.away.teamId, game.home.teamId].map(function (id) { return (currentTeams.get(id) || {}).games; });
  if (gp.some(function (g) { return !isFinite(g); })) throw new MissingData_('Baseball-Reference has no games-played for one of the teams');
  var currentGames = Math.min(gp[0], gp[1]);
  var seasons = D.seasonsNeeded(season, currentGames, cfg);
  if (seasons.length > 1) warnings.push('Only ' + currentGames + ' games played in ' + season + '; blending ' + seasons.join(' + ') + ' (rule threshold: ' + cfg.sampleWindow.minCurrentSeasonGames + ').');

  var fg = cfg.useFangraphs !== false;
  var texts = {}, absent = [];
  if (fg) seasons.forEach(function (s) {
    ['bullpen', 'team_wrc', 'team_frv'].forEach(function (k) {
      var f = FgStore_.get(k, s);
      if (!f) absent.push(k + '_' + s + ' (Play log tab -> FanGraphs files)');
      else {
        texts[k + '_' + s] = f.text;
        var age = (Date.now() - f.uploadedAt) / (24 * HOUR_S_ * 1000);
        if (s === season && age > cfg.csvMaxAgeDays) warnings.push(k + '_' + s + ' was uploaded ' + age.toFixed(1) + ' days ago - upload a fresh export for today\'s numbers');
      }
    });
  });
  if (absent.length) throw new MissingData_('Missing FanGraphs upload(s):', absent);

  var teamOff = [], batterRows = [], pitcherRows = [], bullpens = [], wrcs = [], frvs = [];
  seasons.forEach(function (s) {
    teamOff.push(s === season ? currentTeams : bbrefTeams_(s, false));
    batterRows.push(D.parseSavantPlayers(fetchText_(savantUrl_(s, 'batter', BATTER_SEL_), 'sv_b3_' + s, 6 * HOUR_S_)));
    pitcherRows.push(D.parseSavantPlayers(fetchText_(savantUrl_(s, 'pitcher', PITCHER_SEL_), 'sv_p2_' + s, 6 * HOUR_S_)));
    if (!fg) return;
    var bp = D.parseTeamTable(texts['bullpen_' + s], D.BULLPEN_SPEC).teams;
    if (Array.from(bp.values()).some(function (v) { return !isFinite(v.woba) || !isFinite(v.ip) || !isFinite(v.bf); }))
      throw new MissingData_('bullpen_' + s + ' must have numeric IP, TBF and wOBA for every team');
    bullpens.push(bp);
    wrcs.push(D.parseTeamTable(texts['team_wrc_' + s], D.WRC_SPEC).teams);
    frvs.push(D.parseTeamTable(texts['team_frv_' + s], D.FRV_SPEC).teams);
  });

  var wrc = new Map(), frv = new Map();
  if (fg) U.TEAMS.forEach(function (t) {
    var sw = 0, sv = 0, fs = 0, any = false;
    seasons.forEach(function (s, i) {
      var w = (teamOff[i].get(t.id) || {}).pa, r = wrcs[i].get(t.id), f = frvs[i].get(t.id);
      if (r && isFinite(r.wrcPlus) && isFinite(w)) { sw += w; sv += r.wrcPlus * w; any = true; }
      if (f && isFinite(f.frv)) fs += f.frv;
    });
    if (any) wrc.set(t.id, { wrcPlus: sv / sw });
    if (frvs.some(function (m) { return m.has(t.id); })) frv.set(t.id, { frv: fs });
  });

  // Model v2 always uses this season and last season (last season at 0.6 weight), whatever the legacy rule chose
  var v2 = { teamsCur: currentTeams, seasons: [season - 1, season] };
  [season - 1, season].forEach(function (s) {
    var i = seasons.indexOf(s), cur = s === season, tag = cur ? 'Cur' : 'Prev';
    v2['bat' + tag] = i >= 0 ? batterRows[i] : D.parseSavantPlayers(fetchText_(savantUrl_(s, 'batter', BATTER_SEL_), 'sv_b3_' + s, 6 * HOUR_S_));
    v2['pit' + tag] = i >= 0 ? pitcherRows[i] : D.parseSavantPlayers(fetchText_(savantUrl_(s, 'pitcher', PITCHER_SEL_), 'sv_p2_' + s, 6 * HOUR_S_));
    if (!cur) v2.teamsPrev = i >= 0 ? teamOff[i] : bbrefTeams_(s, false);
  });
  // Catcher framing + fielders for "Model v3 + defense" (2026-10-16). Optional: a failure only skips that model.
  try {
    var d = { framing: {}, oaa: {} };
    [season - 1, season].forEach(function (s) {
      var tag = s === season ? 'cur' : 'prev', ttl = 6 * HOUR_S_;
      d.framing[tag] = D.parseSavantFraming(fetchText_(framingUrl_(s), 'sv_fr_' + s, ttl));
      d.oaa[tag] = D.parseSavantOaa(fetchText_(oaaUrl_(s), 'sv_oaa_' + s, ttl));
    });
    v2.defense = d;
  } catch (e) { warnings.push('Savant catcher framing / fielding not loaded (' + e.message + '); Model v3 + defense skipped'); }
  // Hands (MLB Stats API) and each starter's pitch file (Savant) for "Model v3 full". Optional.
  try {
    var ids = [];
    [game.away, game.home].forEach(function (sd) { sd.lineup.forEach(function (x) { ids.push(x.id); }); if (sd.probable) ids.push(sd.probable.id); });
    v2.hands = D.parseHands(JSON.parse(fetchText_('https://statsapi.mlb.com/api/v1/people?personIds=' + ids.join(','), null, 0)));
  } catch (e) { warnings.push('Batter/pitcher hands not loaded (' + e.message + '); Model v3 full skipped'); }
  try {
    var pairs = {};
    [game.away, game.home].forEach(function (sd) {
      if (!sd.probable) return;
      var pid = sd.probable.id, d = {};
      [season - 1, season].forEach(function (s) {
        var tag = s === season ? 'cur' : 'prev', key = 'sv_pair_' + pid + '_' + s, cache = CacheService.getScriptCache(), hit = cache.get(key);
        if (hit) { d[tag] = JSON.parse(hit); return; }
        d[tag] = D.parseStatcastPairs(fetchText_(pitchFileUrl_(s, pid), null, 0));   // big file: cache the summary, not the text
        try { cache.put(key, JSON.stringify(d[tag]), 6 * HOUR_S_); } catch (e2) { /* fine */ }
      });
      pairs[pid] = d;
    });
    v2.pairs = pairs;
  } catch (e) { warnings.push('Savant pitch file for a starter not loaded (' + e.message + '); pairing left at average'); }

  return { warnings: warnings, sources: { v2: D.v2Sources(v2, cfg.v2), batterIndex: D.indexPlayers(batterRows), pitcherIndex: D.indexPlayers(pitcherRows),
    teamOffense: D.blendTeamTables(teamOff), bullpen: fg ? D.blendBullpens(bullpens) : new Map(), wrc: wrc, frv: frv, seasonsUsed: seasons } };
}

// ---------- odds feed (optional) ----------
var oddsMemo_ = null;   // one request per execution
function oddsEvents_() {
  var key = oddsKey_();
  if (!key) return null;
  if (oddsMemo_) return oddsMemo_;
  var res = UrlFetchApp.fetch(R_('odds').ODDS_URL(key, R_('config').oddsRegions), { muteHttpExceptions: true });
  var left = res.getHeaders()['x-requests-remaining'] || res.getHeaders()['X-Requests-Remaining'];
  if (left != null) PropertiesService.getScriptProperties().setProperty('ODDS_REMAINING', String(left));
  if (res.getResponseCode() !== 200) throw new Error('The Odds API returned HTTP ' + res.getResponseCode());
  oddsMemo_ = JSON.parse(res.getContentText());
  return oddsMemo_;
}

function booksFor_(r) {
  try {
    var events = oddsEvents_(), U = R_('util');
    var a = U.findTeam(r.away), h = U.findTeam(r.home);
    return events && a && h ? R_('odds').gameBooks(events, { awayId: a.id, homeId: h.id, startUtc: r.startUtc }) : [];
  } catch (e) { console.error('odds: ' + e.message); return []; }
}

// ---------- the timer: final scores + closing lines ----------
// Runs every 5 minutes (installed by setup()). Finals: games whose start time has passed. Closing line: one
// capture per game, within cfg.closingCaptureMinutes before first pitch (1 odds request covers all such games).
function refreshLog() {
  var L = R_('playlog'), O = R_('odds'), cfg = config_(), now = Date.now();
  var rows = LogStore_.list();
  var due = rows.filter(function (r) { return r.finalAway === null && !/postponed|cancel/i.test(r.gameStatus || '') && Date.parse(r.startUtc) < now; });
  var pks = []; due.forEach(function (r) { if (pks.indexOf(r.gamePk) < 0) pks.push(r.gamePk); });
  var statuses = {};
  if (pks.length) {
    var j = JSON.parse(fetchText_('https://statsapi.mlb.com/api/v1/schedule?sportId=1&gamePks=' + pks.join(',')));
    (j.dates || []).forEach(function (d) { (d.games || []).forEach(function (g) {
      statuses[g.gamePk] = { status: g.status && g.status.detailedState, awayScore: g.teams.away.score, homeScore: g.teams.home.score };
    }); });
  }
  var win = cfg.closingCaptureMinutes * 60 * 1000;
  var needClose = oddsKey_() ? rows.filter(function (r) { var t = Date.parse(r.startUtc) - now; return !r.close_source && t <= win && t > -2 * 60 * 1000; }) : [];
  var changed = {};
  rows.forEach(function (r) {
    var x = r;
    if (statuses[r.gamePk]) x = L.applyFinal(x, statuses[r.gamePk]);
    if (needClose.indexOf(r) >= 0) { var m = O.summarizeBooks(booksFor_(r)); if (m) x = L.applyClosing(x, m); }
    if (JSON.stringify(x) !== JSON.stringify(r)) changed[r.id] = x;
  });
  var n = Object.keys(changed).length;
  if (n) LogStore_.updateMany(changed);
  return { checkedFinals: due.length, closingChecked: needClose.length, rowsUpdated: n };
}

// ---------- storage: the log spreadsheet ----------
function logSpreadsheet_() {
  var id = prop_('LOG_SHEET_ID');
  if (id) return SpreadsheetApp.openById(id);
  var ss = SpreadsheetApp.create('MLB Play Log');
  PropertiesService.getScriptProperties().setProperty('LOG_SHEET_ID', ss.getId());
  return ss;
}

// Text is written with a leading apostrophe so Sheets keeps it as text (no date conversion, and a note that
// starts with "=" can never run as a formula); Sheets doesn't include the apostrophe in the value it returns.
function cellOut_(v) {
  if (v === null || v === undefined) return '';
  if (typeof v === 'number') return isFinite(v) ? v : '';
  var s = String(v);
  return s === '' ? '' : "'" + s;
}

var LogStore_ = {
  NAME: 'PlayLog',
  sheet_: function () {
    var ss = logSpreadsheet_(), sh = ss.getSheetByName(this.NAME), cols = R_('playlog').CSV_COLUMNS;
    if (!sh) { sh = ss.insertSheet(this.NAME); sh.getRange(1, 1, 1, cols.length).setValues([cols]); sh.setFrozenRows(1); }
    // add any columns a newer version introduced, at the end
    var head = sh.getRange(1, 1, 1, Math.max(1, sh.getLastColumn())).getValues()[0].map(String);
    var missing = cols.filter(function (c) { return head.indexOf(c) < 0; });
    if (missing.length) { sh.getRange(1, head.length + 1, 1, missing.length).setValues([missing]); head = head.concat(missing); }
    return { sh: sh, head: head };
  },
  toRow_: function (head, values) {
    var num = R_('playlog').NUMERIC_COLUMNS, o = {};
    head.forEach(function (c, i) {
      var v = values[i];
      if (num.has(c)) o[c] = v === '' || v === null ? null : Number(v);
      else o[c] = v === null || v === undefined ? '' : (v instanceof Date ? v.toISOString() : String(v));
    });
    return o;
  },
  list: function () {
    var t = this.sheet_(), n = t.sh.getLastRow();
    if (n < 2) return [];
    var self = this;
    return t.sh.getRange(2, 1, n - 1, t.head.length).getValues().map(function (v) { return self.toRow_(t.head, v); });
  },
  rowIndex_: function (t, id) {
    var n = t.sh.getLastRow(); if (n < 2) return -1;
    var ids = t.sh.getRange(2, 1, n - 1, 1).getValues().map(function (v) { return String(v[0]); });
    var i = ids.indexOf(String(id));
    return i < 0 ? -1 : i + 2;
  },
  write_: function (t, rowNum, row) { t.sh.getRange(rowNum, 1, 1, t.head.length).setValues([t.head.map(function (c) { return cellOut_(row[c]); })]); },
  insert: function (row) {
    var lock = LockService.getScriptLock(); lock.waitLock(20000);
    try { var t = this.sheet_(); this.write_(t, t.sh.getLastRow() + 1, row); return row; } finally { lock.releaseLock(); }
  },
  update: function (id, fn) {
    var lock = LockService.getScriptLock(); lock.waitLock(20000);
    try {
      var t = this.sheet_(), i = this.rowIndex_(t, id); if (i < 0) return null;
      var cur = this.toRow_(t.head, t.sh.getRange(i, 1, 1, t.head.length).getValues()[0]);
      var next = fn(cur); this.write_(t, i, next); return next;
    } finally { lock.releaseLock(); }
  },
  updateMany: function (byId) {
    var lock = LockService.getScriptLock(); lock.waitLock(20000);
    try { var t = this.sheet_(), self = this; Object.keys(byId).forEach(function (id) { var i = self.rowIndex_(t, id); if (i > 0) self.write_(t, i, byId[id]); }); }
    finally { lock.releaseLock(); }
  },
  remove: function (id) {
    var lock = LockService.getScriptLock(); lock.waitLock(20000);
    try { var t = this.sheet_(), i = this.rowIndex_(t, id); if (i < 0) return false; t.sh.deleteRow(i); return true; } finally { lock.releaseLock(); }
  },
};

// FanGraphs uploads: one row per upload in the "FanGraphs" tab (kind, season, uploadedAt, csv text).
var FgStore_ = {
  NAME: 'FanGraphs',
  sheet_: function () {
    var ss = logSpreadsheet_(), sh = ss.getSheetByName(this.NAME);
    if (!sh) { sh = ss.insertSheet(this.NAME); sh.getRange(1, 1, 1, 4).setValues([['kind', 'season', 'uploadedAt', 'csv']]); sh.setFrozenRows(1); }
    return sh;
  },
  put: function (kind, season, text) {
    if (text.length > 49000) throw new Error('That file is too large to store (limit about 49,000 characters)');
    var sh = this.sheet_();
    sh.getRange(sh.getLastRow() + 1, 1, 1, 4).setValues([[cellOut_(kind), cellOut_(season), cellOut_(new Date().toISOString()), cellOut_(text)]]);
  },
  get: function (kind, season) {
    var sh = this.sheet_(), n = sh.getLastRow(); if (n < 2) return null;
    var rows = sh.getRange(2, 1, n - 1, 4).getValues(), best = null;
    rows.forEach(function (r) { if (String(r[0]) === kind && String(r[1]) === String(season)) { var at = Date.parse(String(r[2])); if (!best || at >= best.uploadedAt) best = { uploadedAt: at, text: String(r[3]) }; } });
    return best;
  },
};

// ---------- Bet Desk slate export (2026-10-17, J: the full model inside Bet Desk) ----------
// Runs every game on a date through every model and writes one JSON file, "mlb_slate.json", to the "Bet Desk MLB" folder
// in your Drive. Bet Desk reads that file through your Google Drive connector. A timer (installSlateTimer) refreshes it
// every 30 minutes; each game's result is cached by its lineups and starters so later runs only redo games that changed.
// Nothing here writes to the play log.
var SLATE_FILE_ = 'mlb_slate.json', SLATE_FOLDER_ = 'Bet Desk MLB';

function slateGame_(game, cfg) {
  var G = R_('game'), out = { gamePk: game.gamePk, date: game.date, startUtc: game.startUtc || '', away: game.away.name, home: game.home.name,
    awaySP: game.away.probable ? game.away.probable.name : null, homeSP: game.home.probable ? game.home.probable.name : null,
    lineupsPosted: !!(game.away.lineupPosted && game.home.lineupPosted) };
  var ready = G.readiness(game);
  if (!ready.ready) { out.status = 'waiting'; out.notes = ready.problems; return out; }
  var loaded = loadSources_(game, cfg), r = G.runGame(game, loaded.sources, cfg);
  if (!r.ok) { out.status = 'missing'; out.notes = r.missing; return out; }
  var R = r.result, pick = function (m) { return m ? { runsAway: m.runsAway, runsHome: m.runsHome, homeWinProb: m.homeWinProb } : null; };
  out.status = 'ok';
  out.models = { eff: R.eff ? Object.assign(pick(R.eff), { total: R.eff.total, totals: R.eff.totals, pythHomeWinProb: R.eff.pythHomeWinProb }) : null, v3: R.v3 ? Object.assign(pick(R.v3), { total: R.v3.total, totals: R.v3.totals }) : null, v3d: pick(R.v3d), v3f: pick(R.v3f),
    sheetPyth: R.pythagorean ? { homeWinProb: R.pythagorean.homeWinProb } : null, sheetMC: R.hierarchical ? { homeWinProb: R.hierarchical.homeWinProb } : null };
  var dv = function (side) {
    var s3 = R.eff ? R.eff.sides[side] : R.v3 && R.v3.sides[side], d = R.v3d && R.v3d.defense[side], f = R.v3f && R.v3f.extra[side];
    return { efficiency: s3 ? s3.efficiency : null, efficiencySource: s3 && s3.source ? s3.source : null, seasonRpg: R.v3 && R.v3.sides[side] ? R.v3.sides[side].seasonRpg : null, framing: d ? d.framing : null, catcher: d ? d.catcher : null,
      fielding: d ? d.fielding : null, platoon: f ? f.platoon : null, pairing: f ? f.tandem : null, starterThrows: f ? f.starterThrows : null };
  };
  out.inputs = { away: dv('away'), home: dv('home'), tempF: R.v3 ? R.v3.tempF : null, parkFactor: R.parkFactor };
  out.warnings = loaded.warnings.concat(r.warnings);
  return out;
}

function exportSlate(date) {
  var t0 = Date.now(), G = R_('game'), cfg = config_(), cache = CacheService.getScriptCache();
  cfg.useFangraphs = settings_().useFangraphs;
  date = typeof date === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(date) ? date : today_();
  var games = G.parseGames(fetchSchedule_(date), cfg), rows = [], pending = 0;
  games.forEach(function (g) {
    var sig = [g.gamePk, g.away.probable && g.away.probable.id, g.home.probable && g.home.probable.id,
      g.away.lineup.map(function (x) { return x.id; }).join('.'), g.home.lineup.map(function (x) { return x.id; }).join('.'), cfg.useFangraphs].join('|');
    var key = 'slate_' + Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, sig)), hit = cache.get(key);
    if (hit) { rows.push(JSON.parse(hit)); return; }
    if (Date.now() - t0 > 4.5 * 60 * 1000) { pending++; rows.push({ gamePk: g.gamePk, away: g.away.name, home: g.home.name, startUtc: g.startUtc || '', status: 'pending' }); return; }
    var row;
    try { row = slateGame_(g, cfg); } catch (e) { row = { gamePk: g.gamePk, away: g.away.name, home: g.home.name, startUtc: g.startUtc || '', status: 'error', notes: [String(e && e.message || e)] }; }
    row = JSON.parse(JSON.stringify(row, function (k, v) { return typeof v === 'number' && !isFinite(v) ? null : v; }));
    if (row.status === 'ok' || row.status === 'waiting') { try { cache.put(key, JSON.stringify(row), row.status === 'ok' ? 3 * HOUR_S_ : 20 * 60); } catch (e2) { /* too big */ } }
    rows.push(row);
  });
  var v = cfg.v3, doc = { updatedAt: new Date().toISOString(), date: date, pending: pending, source: 'MLB Apps Script app',
    meta: { nbAlpha: { eff: cfg.eff.nbAlpha, v3: cfg.v3.nbAlpha, v3d: cfg.v3d.nbAlpha, v3f: cfg.v3f.nbAlpha }, totalsCalSlope: v.totalsCalSlope,
      totalsCalSlopeByModel: { eff: cfg.eff.totalsCalSlope, v3: v.totalsCalSlope }, tieHomeWin: cfg.v3.tieHomeWin,
      marketBlend: cfg.eff.marketBlend, marketBlendByModel: { eff: cfg.eff.marketBlend, v3: cfg.v3.marketBlend }, primary: 'eff', loggingOnly: ['v3', 'v3d', 'v3f'] },
    games: rows };
  savePregame_(rows);
  doc.finals = recentFinals_(date);
  var text = JSON.stringify(doc), folder = slateFolder_(), files = folder.getFilesByName(SLATE_FILE_);
  if (files.hasNext()) files.next().setContent(text); else folder.createFile(SLATE_FILE_, text, 'application/json');
  Logger.log('mlb_slate.json: ' + rows.length + ' games (' + rows.filter(function (r) { return r.status === 'ok'; }).length + ' run, ' + pending + ' left for the next pass)');
  return doc;
}

// Final scores of the last 3 days (2026-10-18, model tracker: the cloud cannot reach MLB Stats API, so grading reads them here)
function recentFinals_(date) {
  try {
    var d = new Date(date + 'T12:00:00Z'), start = new Date(d.getTime() - 3 * 86400000), f = function (x) { return Utilities.formatDate(x, 'UTC', 'yyyy-MM-dd'); };
    var sch = JSON.parse(fetchText_('https://statsapi.mlb.com/api/v1/schedule?sportId=1&startDate=' + f(start) + '&endDate=' + date, 'fin_' + date, 30 * 60)), out = [];
    var P = PropertiesService.getScriptProperties();
    (sch.dates || []).forEach(function (day) {
      (day.games || []).forEach(function (g) {
        if (!g.status || g.status.abstractGameState !== 'Final' || g.teams.away.score == null) return;
        var pre = P.getProperty(PRE_KEY_ + g.gamePk);
        out.push({ gamePk: g.gamePk, date: day.date, away: g.teams.away.team.name, home: g.teams.home.team.name, awayRuns: g.teams.away.score, homeRuns: g.teams.home.score,
          pregame: pre ? JSON.parse(pre) : null });
      });
    });
    return out;
  } catch (e) { return []; }
}

// Last projection made before first pitch, per game (2026-10-19, model tracking: each finals entry carries it as
// "pregame" so grading can score MLB games; the slate itself is read in the morning, before lineups post).
// Kept in Script Properties ("slate_pre_<gamePk>"), dropped 7 days after first pitch. Model math unchanged.
var PRE_KEY_ = 'slate_pre_';
function savePregame_(rows) {
  var P = PropertiesService.getScriptProperties(), now = Date.now();
  var p = function (x) { return x ? { runsAway: x.runsAway, runsHome: x.runsHome, homeWinProb: x.homeWinProb } : null; };
  rows.forEach(function (r) {
    var st = Date.parse(r.startUtc || '');
    if (r.status !== 'ok' || !r.models || !isFinite(st) || now >= st) return;
    var m = r.models, rec = { madeAt: new Date(now).toISOString(), startUtc: r.startUtc, lineupsPosted: r.lineupsPosted, awaySP: r.awaySP, homeSP: r.homeSP,
      models: { eff: m.eff ? Object.assign(p(m.eff), { total: m.eff.total }) : null, v3: m.v3 ? Object.assign(p(m.v3), { total: m.v3.total }) : null, v3d: p(m.v3d), v3f: p(m.v3f) } };
    var key = PRE_KEY_ + r.gamePk, old = P.getProperty(key), same = false;
    if (old) { try { var o = JSON.parse(old); o.madeAt = rec.madeAt; same = JSON.stringify(o) === JSON.stringify(rec); } catch (e) { /* rewrite */ } }
    if (!same) P.setProperty(key, JSON.stringify(rec));
  });
  try {
    var all = P.getProperties();
    Object.keys(all).forEach(function (k) {
      if (k.indexOf(PRE_KEY_) !== 0) return;
      try { if (now - Date.parse(JSON.parse(all[k]).startUtc) > 7 * 86400000) P.deleteProperty(k); } catch (e) { P.deleteProperty(k); }
    });
  } catch (e) { /* pruning is best-effort */ }
}

function slateFolder_() {
  var it = DriveApp.getFoldersByName(SLATE_FOLDER_);
  return it.hasNext() ? it.next() : DriveApp.createFolder(SLATE_FOLDER_);
}

// Run once from the editor: refreshes mlb_slate.json for today every 30 minutes.
function installSlateTimer() {
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'slateTimer_') ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('slateTimer_').timeBased().everyMinutes(30).create();
  exportSlate();
  Logger.log('Timer installed: mlb_slate.json refreshes every 30 minutes (Drive folder "' + SLATE_FOLDER_ + '").');
}
function slateTimer_() { exportSlate(); }

// ---------- one-time setup and checks (run from the editor) ----------
function setup() {
  var ss = logSpreadsheet_();
  LogStore_.sheet_(); FgStore_.sheet_();
  var first = ss.getSheets()[0];
  if (first && first.getName() !== LogStore_.NAME && first.getName() !== FgStore_.NAME && first.getLastRow() === 0) ss.deleteSheet(first);
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'refreshLog') ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('refreshLog').timeBased().everyMinutes(5).create();
  Logger.log('Log spreadsheet: ' + ss.getUrl());
  Logger.log('Timer installed: refreshLog every 5 minutes.');
  Logger.log('Odds feed key set: ' + (oddsKey_() ? 'yes' : 'no (optional)'));
}

function checkOddsFeed() {
  if (!oddsKey_()) { Logger.log('No ODDS_API_KEY in Script Properties.'); return; }
  var events = oddsEvents_(), books = {};
  events.forEach(function (e) { (e.bookmakers || []).forEach(function (b) { books[b.title || b.key] = true; }); });
  Logger.log('PASS odds feed: ' + events.length + ' MLB games listed, books: ' + Object.keys(books).sort().join(', '));
  Logger.log('Credits left this month: ' + prop_('ODDS_REMAINING'));
  var e0 = events[0], U = R_('util');
  if (e0) {
    var a = U.findTeam(e0.away_team), h = U.findTeam(e0.home_team);
    var bk = R_('odds').gameBooks(events, { awayId: a && a.id, homeId: h && h.id, startUtc: e0.commence_time });
    Logger.log((bk.length ? 'PASS' : 'FAIL') + ' parsing ' + e0.away_team + ' @ ' + e0.home_team + ': ' + bk.length + ' books, e.g. ' + (bk[0] ? bk[0].book + ' ' + bk[0].awayMl + '/' + bk[0].homeMl : '-'));
  }
}
